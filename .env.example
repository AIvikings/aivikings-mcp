# Internal REST address reached by this service. No privileged backend key is needed.
AIVIKINGS_API_BASE_URL=http://127.0.0.1:8080
# Public URLs advertised to OAuth/MCP clients.
AIVIKINGS_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
AIVIKINGS_MCP_URL=http://127.0.0.1:8081/mcp
AIVIKINGS_MCP_HOST=127.0.0.1
AIVIKINGS_MCP_PORT=8081
AIVIKINGS_MCP_PATH=/mcp
AIVIKINGS_MCP_REQUEST_TIMEOUT_SECONDS=120
# Caller bearer tokens are forwarded per request and verified by the backend.
